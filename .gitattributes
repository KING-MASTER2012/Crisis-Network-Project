# Default behaviour: Adapt according to the OS but keep LF in repo.
* text=auto

# Core code files have to LF in any OS every time.
*.rs text eol=lf
*.go text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.js text eol=lf

# Special bethics according to OS
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Gradle wrapper: the Unix script must keep LF (a CRLF "#!/bin/sh^M" does not run), the batch
# file keeps CRLF, the wrapper JAR is binary.
gradlew text eol=lf
gradlew.bat text eol=crlf
*.jar binary

# Standart Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.ttf binary
*.wav binary
*.mp3 binary
*.fbx binary
*.obj binary
