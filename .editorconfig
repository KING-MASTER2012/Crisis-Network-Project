root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = crlf
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = tab

# Windows scripts
[*.{bat,cmd,ps1}]
end_of_line = crlf

# Unix scripts must keep LF line endings.
[{gradlew,gradlew.sh,*.sh}]
end_of_line = lf
