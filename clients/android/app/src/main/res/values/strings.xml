    <string name="onb_welcome_title">Welcome to Crisis Network</string>
    <string name="onb_welcome_body">Message the people around you when the phone network and the internet are down.</string>
    <string name="onb_point_offline_title">Works without internet</string>
    <string name="onb_point_offline_body">Phones talk to each other directly over Bluetooth. Nothing needs a mobile network or Wi-Fi.</string>
    <string name="onb_point_relay_title">Messages hop from phone to phone</string>
    <string name="onb_point_relay_body">Every phone that runs the app passes messages on, so they can travel further than one Bluetooth link reaches.</string>
    <string name="onb_point_private_title">No account, no phone number</string>
    <string name="onb_point_private_body">You are identified by a key that is created on this phone. Private messages are encrypted; announcements are public.</string>
    <string name="onb_identity_title">Create your identity</string>
    <string name="onb_identity_body">The app creates a key pair on this phone. The secret part is kept in the phone’s protected storage and never leaves it. There is nothing to sign up for.</string>
