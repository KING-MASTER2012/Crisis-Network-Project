#!/bin/sh
#
# Gradle start up script for POSIX shells (Linux, macOS, CI).
# Windows uses gradlew.bat. Both start gradle/wrapper/gradle-wrapper.jar, which downloads and
# runs the Gradle version named in gradle/wrapper/gradle-wrapper.properties.
#
# NOTE: this file must never call itself (an earlier version did: `exec "$(dirname "$0")/gradlew"`
# re-ran the script forever, which is why CI "hung"). It starts Java directly.

# Resolve symlinks so that APP_HOME is the real directory of this script.
app_path=$0
while [ -h "$app_path" ]; do
    ls=$( ls -ld -- "$app_path" )
    link=${ls#*' -> '}
    case $link in
        /*) app_path=$link ;;
        *) app_path=${app_path%"${app_path##*/}"}$link ;;
    esac
done
APP_HOME=$( cd -P "${app_path%"${app_path##*/}"}." > /dev/null && printf '%s\n' "$PWD" ) || exit
APP_BASE_NAME=${0##*/}

# Locate Java: JAVA_HOME first, then `java` on the PATH.
if [ -n "$JAVA_HOME" ]; then
    if [ -x "$JAVA_HOME/jre/sh/java" ]; then
        JAVACMD=$JAVA_HOME/jre/sh/java # IBM's JDK on AIX
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi
    if [ ! -x "$JAVACMD" ]; then
        echo "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME" >&2
        echo "Please set JAVA_HOME to your Java installation." >&2
        exit 1
    fi
else
    JAVACMD=java
    if ! command -v java > /dev/null 2>&1; then
        echo "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH." >&2
        echo "Please set JAVA_HOME to your Java installation." >&2
        exit 1
    fi
fi

WRAPPER_JAR=$APP_HOME/gradle/wrapper/gradle-wrapper.jar
if [ ! -f "$WRAPPER_JAR" ]; then
    echo "ERROR: $WRAPPER_JAR not found." >&2
    exit 1
fi

# Extra JVM options for the small wrapper JVM (not for the Gradle daemon: see gradle.properties).
# $JAVA_OPTS and $GRADLE_OPTS are split on whitespace on purpose.
# shellcheck disable=SC2086
exec "$JAVACMD" -Xmx64m -Xms64m $JAVA_OPTS $GRADLE_OPTS \
    "-Dorg.gradle.appname=$APP_BASE_NAME" \
    -jar "$WRAPPER_JAR" "$@"
