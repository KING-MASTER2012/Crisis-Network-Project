    "settings_mac_login_unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening at login is not possible from here. Move the app to the Applications folder and open it from there."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açılışında açma buradan mümkün değil. Uygulamayı Uygulamalar klasörüne taşıyıp oradan açın."
          }
        }
