{
  "sourceLanguage": "en",
  "strings": {
    "add_cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazgeç"
          }
        }
      }
    },
    "add_confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add contact"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişiyi ekle"
          }
        }
      }
    },
    "add_done": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The contact was added."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişi eklendi."
          }
        }
      }
    },
    "add_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The contact could not be added. Try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişi eklenemedi. Yeniden deneyin."
          }
        }
      }
    },
    "add_finish": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamam"
          }
        }
      }
    },
    "add_invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not a valid card."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu geçerli bir kart değil."
          }
        }
      }
    },
    "add_nickname": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nickname (optional)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takma ad (isteğe bağlı)"
          }
        }
      }
    },
    "add_own": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is your own card."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sizin kendi kartınız."
          }
        }
      }
    },
    "add_queued": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The card is saved. The contact is added as soon as you join the mesh."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kart kaydedildi. Ağa katılır katılmaz kişi eklenecek."
          }
        }
      }
    },
    "add_safety_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check it against what the other person’s device shows, in person or on a call you trust."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karşınızdaki kişinin cihazında görünenle karşılaştırın; yüz yüze ya da güvendiğiniz bir görüşmede."
          }
        }
      }
    },
    "add_safety_label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safety number"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik numarası"
          }
        }
      }
    },
    "add_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add contact"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişi ekle"
          }
        }
      }
    },
    "app_name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crisis Network"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kriz Ağı"
          }
        }
      }
    },
    "bt_denied_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without Bluetooth the app cannot find or reach other devices. Open the settings and allow Bluetooth for Crisis Network."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth olmadan uygulama başka cihazları bulamaz ve onlara ulaşamaz. Ayarları açıp Kriz Ağı için Bluetooth’a izin verin."
          }
        }
      }
    },
    "bt_denied_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is not allowed"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth’a izin verilmedi"
          }
        }
      }
    },
    "bt_off_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn Bluetooth on to find and reach other devices."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer cihazları bulmak ve onlara ulaşmak için Bluetooth’u açın."
          }
        }
      }
    },
    "bt_off_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is off"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth kapalı"
          }
        }
      }
    },
    "bt_open_settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarları aç"
          }
        }
      }
    },
    "bt_restricted_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is restricted on this device, for example by Screen Time or a management profile, so the app cannot use it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth bu cihazda kısıtlı (örneğin Ekran Süresi veya bir yönetim profili tarafından), bu yüzden uygulama onu kullanamıyor."
          }
        }
      }
    },
    "bt_restricted_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is restricted"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth kısıtlı"
          }
        }
      }
    },
    "bt_turn_on": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Bluetooth"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth’u aç"
          }
        }
      }
    },
    "bt_unsupported_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device does not support Bluetooth Low Energy, which the app needs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaz, uygulamanın ihtiyaç duyduğu Bluetooth Low Energy’yi desteklemiyor."
          }
        }
      }
    },
    "bt_unsupported_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is not available"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth kullanılamıyor"
          }
        }
      }
    },
    "contact_block": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Engelle"
          }
        }
      }
    },
    "contact_block_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages from a blocked contact are dropped and never passed on."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Engellenen kişiden gelen mesajlar atılır ve hiçbir zaman iletilmez."
          }
        }
      }
    },
    "contact_block_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block this contact?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kişi engellensin mi?"
          }
        }
      }
    },
    "contact_change_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change could not be made. Try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklik yapılamadı. Yeniden deneyin."
          }
        }
      }
    },
    "contact_id_line %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address: %@…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres: %@…"
          }
        }
      }
    },
    "contact_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a message"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesaj gönder"
          }
        }
      }
    },
    "contact_needs_mesh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join the mesh to change the trust level."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güven düzeyini değiştirmek için ağa katılın."
          }
        }
      }
    },
    "contact_nickname": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nickname"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takma ad"
          }
        }
      }
    },
    "contact_no_card_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no card for this person, so there is no number to compare. Scan their card first."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kişinin kartı yok, karşılaştırılacak numara da yok. Önce kartını tarayın."
          }
        }
      }
    },
    "contact_no_card_pill": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No card"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kart yok"
          }
        }
      }
    },
    "contact_safety_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the numbers to each other, in person or on a call you trust. They must be identical on both devices."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Numaraları birbirinize okuyun; yüz yüze ya da güvendiğiniz bir görüşmede. İki cihazda da aynı olmalı."
          }
        }
      }
    },
    "contact_safety_theirs": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Theirs"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onunki"
          }
        }
      }
    },
    "contact_safety_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safety numbers"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik numaraları"
          }
        }
      }
    },
    "contact_safety_yours": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yours"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizinki"
          }
        }
      }
    },
    "contact_save": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save nickname"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takma adı kaydet"
          }
        }
      }
    },
    "contact_trust_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trust"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güven"
          }
        }
      }
    },
    "contact_unblock": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unblock"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Engeli kaldır"
          }
        }
      }
    },
    "contact_unknown_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has no card for this person, so it cannot send them messages. Scan their card to add them."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda bu kişinin kartı yok, bu yüzden ona mesaj gönderemez. Eklemek için kartını tarayın."
          }
        }
      }
    },
    "contact_unverify": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove verification"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulamayı kaldır"
          }
        }
      }
    },
    "contact_verify": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The numbers match: mark as verified"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Numaralar aynı: doğrulandı olarak işaretle"
          }
        }
      }
    },
    "contacts_empty_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The people you add by meeting them in person will be listed here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüz yüze görüşerek eklediğiniz kişiler burada listelenecek."
          }
        }
      }
    },
    "contacts_empty_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No contacts yet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kişi yok"
          }
        }
      }
    },
    "contacts_mesh_off_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The list and the trust levels are available while this device is part of the mesh. A card you add now is kept and added as soon as you join. Join from the home screen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste ve güven düzeyleri bu cihaz ağdayken kullanılabilir. Şimdi eklediğiniz kart saklanır ve ağa katılır katılmaz eklenir. Ana ekrandan ağa katılın."
          }
        }
      }
    },
    "contacts_my_card": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show my card"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartımı göster"
          }
        }
      }
    },
    "contacts_paste": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a card as text"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartı metin olarak gir"
          }
        }
      }
    },
    "contacts_scan": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan a card"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kart tara"
          }
        }
      }
    },
    "home_error_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sorun oluştu"
          }
        }
      }
    },
    "home_identity_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read it to a person you meet, so that they can check it against what their phone shows for you."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanıştığınız kişiye okuyun; o da telefonunda sizin için görünen numarayla karşılaştırsın."
          }
        }
      }
    },
    "home_identity_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your safety number"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik numaranız"
          }
        }
      }
    },
    "home_join": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join the mesh"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağa katıl"
          }
        }
      }
    },
    "home_leave": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
