    "settings_notifications": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler"
          }
        }
      }
    },
    "settings_notifications_allow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimlere izin ver"
          }
        }
      }
    },
    "settings_notifications_ask": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off. Allow them to hear about a message when the app is not open."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler kapalı. Uygulama açık değilken bir mesajdan haberdar olmak için izin verin."
          }
        }
      }
    },
    "settings_notifications_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no server to push messages: they arrive over Bluetooth, and the notification appears when the system lets this app run to receive one. Keep the mesh on and Bluetooth allowed in the background."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajları itecek bir sunucu yok: Bluetooth ile gelirler ve bildirim, sistem bu uygulamayı mesajı almak için çalıştırdığında görünür. Ağı açık tutun ve Bluetooth'a arka planda izin verin."
          }
        }
      }
    },
    "settings_notifications_off": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are blocked in the system settings. Allow them there to hear about messages when the app is not open."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler sistem ayarlarında engellenmiş. Uygulama açık değilken mesajlardan haberdar olmak için oradan izin verin."
          }
        }
      }
    },
    "settings_notifications_on": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are on. A message that arrives while the app is not open is shown on the lock screen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler açık. Uygulama açık değilken gelen mesaj kilit ekranında gösterilir."
          }
        }
      }
    },
