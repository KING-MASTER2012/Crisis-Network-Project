        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonun komşuları bulmak için ne kadar çalışacağı. Güçlü ayar komşuları daha hızlı bulur, daha çok pil harcar."
          }
        }
      }
    },
