    "home_offline_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are not part of the mesh. Join to exchange messages with phones around you, without internet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağa bağlı değilsiniz. Katılırsanız internet olmadan çevrenizdeki telefonlarla mesajlaşabilirsiniz."
          }
        }
      }
    },
    "home_profile_line %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Power profile: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güç profili: %@"
          }
        }
      }
    },
    "home_searching_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phones running this app within Bluetooth range are found automatically. This can take a minute."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth menzilindeki bu uygulamayı çalıştıran telefonlar otomatik bulunur. Bu bir dakika sürebilir."
