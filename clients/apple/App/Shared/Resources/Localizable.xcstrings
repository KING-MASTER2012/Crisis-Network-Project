          }
        }
      }
    },
    "home_neighbours %lld": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld neighbour connected"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld neighbours connected"
                }
              }
            }
          }
        },
        "tr": {
          "variations": {
