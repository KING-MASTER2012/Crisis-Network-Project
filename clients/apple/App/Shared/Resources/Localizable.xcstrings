    "settings_mac_dock": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide the Dock icon"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock simgesini gizle"
          }
        }
      }
    },
    "settings_mac_hidden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start without a window at login"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açılışında pencere olmadan başlat"
          }
        }
      }
    },
    "settings_mac_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing the window does not stop the mesh: the app keeps running in the menu bar. Quitting the app (Cmd-Q) stops it. The Dock icon can only be hidden while the menu bar icon is shown, so that the app can always be reached."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencereyi kapatmak ağı durdurmaz: uygulama menü çubuğunda çalışmaya devam eder. Uygulamadan çıkmak (Cmd-Q) onu durdurur. Uygulamaya her zaman ulaşılabilsin diye Dock simgesi yalnızca menü çubuğu simgesi görünürken gizlenebilir."
          }
        }
      }
    },
    "settings_mac_login": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at login"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açıldığında aç"
          }
        }
      }
    },
    "settings_mac_login_approval": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Crisis Network in System Settings > General > Login Items to finish."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitirmek için Sistem Ayarları > Genel > Oturum Açma Öğeleri’nde Crisis Network’e izin verin."
          }
        }
      }
    },
    "settings_mac_login_error %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The setting could not be changed: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayar değiştirilemedi: %@"
          }
        }
