{
  "sourceLanguage": "en",
  "strings": {
    "a11y_message_incoming": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Received message"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelen mesaj"
          }
        }
      }
    },
    "a11y_message_outgoing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent by you"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizin gönderdiğiniz"
          }
        }
      }
    },
    "add_cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazgeç"
          }
        }
      }
    },
    "add_confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add contact"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişiyi ekle"
          }
        }
      }
    },
    "add_done": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The contact was added. Your card was sent to them as well, so they can write back without scanning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişi eklendi. Kartınız da ona gönderildi, böylece tarama yapmadan size yazabilir."
          }
        }
      }
    },
    "add_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The contact could not be added. Try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişi eklenemedi. Yeniden deneyin."
          }
        }
      }
    },
    "add_finish": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamam"
          }
        }
      }
    },
    "add_invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not a valid card."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu geçerli bir kart değil."
          }
        }
      }
    },
    "add_nickname": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nickname (optional)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takma ad (isteğe bağlı)"
          }
        }
      }
    },
    "add_own": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is your own card."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sizin kendi kartınız."
          }
        }
      }
    },
    "add_queued": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The card is saved. The contact is added as soon as you join the mesh."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kart kaydedildi. Ağa katılır katılmaz kişi eklenecek."
          }
        }
      }
    },
    "add_safety_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check it against what the other person’s device shows, in person or on a call you trust."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karşınızdaki kişinin cihazında görünenle karşılaştırın; yüz yüze ya da güvendiğiniz bir görüşmede."
          }
        }
      }
    },
    "add_safety_label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safety number"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik numarası"
          }
        }
      }
    },
    "add_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add contact"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişi ekle"
          }
        }
      }
    },
    "ann_compose_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New announcement"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni duyuru"
          }
        }
      }
    },
    "ann_confirm_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone around you will see it, and it cannot be taken back."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrenizdeki herkes görecek ve geri alınamaz."
          }
        }
      }
    },
    "ann_confirm_title %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Publish as “%@”?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” olarak yayınlansın mı?"
          }
        }
      }
    },
    "ann_field": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Announcement"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duyuru"
          }
        }
      }
    },
    "ann_lifetime_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices delete it when this time is up."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süre dolunca cihazlar duyuruyu siler."
          }
        }
      }
    },
    "ann_lifetime_invalid %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a time between 1 second and %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 saniye ile %@ arasında bir süre seçin."
          }
        }
      }
    },
    "ann_lifetime_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long does it stay?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne kadar kalsın?"
          }
        }
      }
    },
    "ann_public_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone within reach of the mesh can read an announcement. It cannot be taken back: it disappears when its time is up."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağın erişimindeki herkes duyuruyu okuyabilir. Geri alınamaz: süresi dolunca kaybolur."
          }
        }
      }
    },
    "ann_publish": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Publish"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayınla"
          }
        }
      }
    },
    "ann_severity_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How important is it?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne kadar önemli?"
          }
        }
      }
    },
    "ann_write": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write an announcement"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duyuru yaz"
          }
        }
      }
    },
    "announcements_empty_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public messages from devices around you will appear here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrenizdeki cihazlardan gelen herkese açık mesajlar burada görünecek."
          }
        }
      }
    },
    "announcements_empty_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No announcements yet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz duyuru yok"
          }
        }
      }
    },
    "app_name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crisis Network"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kriz Ağı"
          }
        }
      }
    },
    "bt_denied_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without Bluetooth the app cannot find or reach other devices. Open the settings and allow Bluetooth for Crisis Network."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth olmadan uygulama başka cihazları bulamaz ve onlara ulaşamaz. Ayarları açıp Kriz Ağı için Bluetooth’a izin verin."
          }
        }
      }
    },
    "bt_denied_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is not allowed"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth’a izin verilmedi"
          }
        }
      }
    },
    "bt_off_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn Bluetooth on to find and reach other devices."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer cihazları bulmak ve onlara ulaşmak için Bluetooth’u açın."
          }
        }
      }
    },
    "bt_off_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is off"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth kapalı"
          }
        }
      }
    },
    "bt_open_settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarları aç"
          }
        }
      }
    },
    "bt_restricted_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is restricted on this device, for example by Screen Time or a management profile, so the app cannot use it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth bu cihazda kısıtlı (örneğin Ekran Süresi veya bir yönetim profili tarafından), bu yüzden uygulama onu kullanamıyor."
          }
        }
      }
    },
    "bt_restricted_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is restricted"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth kısıtlı"
          }
        }
      }
    },
    "bt_turn_on": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Bluetooth"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth’u aç"
          }
        }
      }
    },
    "bt_unsupported_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device does not support Bluetooth Low Energy, which the app needs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaz, uygulamanın ihtiyaç duyduğu Bluetooth Low Energy’yi desteklemiyor."
          }
        }
      }
    },
    "bt_unsupported_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is not available"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth kullanılamıyor"
          }
        }
      }
    },
    "bytes_counter %lld %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld of %2$lld bytes"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld bayttan %1$lld"
          }
        }
      }
    },
    "bytes_over": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "too long, shorten it"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "çok uzun, kısaltın"
          }
        }
      }
    },
    "chat_blocked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You blocked this contact. Unblock them to write."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kişiyi engellediniz. Yazmak için engeli kaldırın."
          }
        }
      }
    },
    "chat_details": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Details"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrıntılar"
          }
        }
      }
    },
    "chat_empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No messages yet. Say hello."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz mesaj yok. Merhaba deyin."
          }
        }
      }
    },
    "chat_input_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesaj"
          }
        }
      }
    },
    "chat_no_card": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To write to this person you need their contact card. Add it under Contacts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kişiye yazmak için kişi kartına ihtiyacınız var. Kişiler bölümünden ekleyin."
          }
        }
      }
    },
    "chat_preview_mine %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz: %@"
          }
        }
      }
    },
    "chat_send": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönder"
          }
        }
      }
    },
    "chat_unread %lld": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld unread message"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld unread messages"
                }
              }
            }
          }
        },
        "tr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld okunmamış mesaj"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld okunmamış mesaj"
                }
              }
            }
          }
        }
      }
    },
    "chats_empty_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private conversations with the people you trust will appear here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvendiğiniz kişilerle özel yazışmalarınız burada görünecek."
          }
        }
      }
    },
    "chats_empty_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No conversations yet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz sohbet yok"
          }
        }
      }
    },
    "chats_new": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New message"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni mesaj"
          }
        }
      }
    },
    "contact_block": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Engelle"
          }
        }
      }
    },
    "contact_block_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages from a blocked contact are dropped and never passed on."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Engellenen kişiden gelen mesajlar atılır ve hiçbir zaman iletilmez."
          }
        }
      }
    },
    "contact_block_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block this contact?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kişi engellensin mi?"
          }
        }
      }
    },
    "contact_change_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change could not be made. Try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklik yapılamadı. Yeniden deneyin."
          }
        }
      }
    },
    "contact_id_line %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address: %@…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres: %@…"
          }
        }
      }
    },
    "contact_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a message"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesaj gönder"
          }
        }
      }
    },
    "contact_needs_mesh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join the mesh to change the trust level."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güven düzeyini değiştirmek için ağa katılın."
          }
        }
      }
    },
    "contact_nickname": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nickname"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takma ad"
          }
        }
      }
    },
    "contact_no_card_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no card for this person, so there is no number to compare. Scan their card first."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kişinin kartı yok, karşılaştırılacak numara da yok. Önce kartını tarayın."
          }
        }
      }
    },
    "contact_no_card_pill": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No card"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kart yok"
          }
        }
      }
    },
    "contact_safety_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the numbers to each other, in person or on a call you trust. They must be identical on both devices."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Numaraları birbirinize okuyun; yüz yüze ya da güvendiğiniz bir görüşmede. İki cihazda da aynı olmalı."
          }
        }
