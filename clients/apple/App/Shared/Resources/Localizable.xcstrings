    "onb_background_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Staying connected"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlı kalmak"
          }
        }
      }
    },
    "onb_bg_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS pauses apps that are not on screen. Bluetooth can wake the app for a few seconds when a nearby device sends something, and the system can start it again after it closed it. The app cannot run all the time as it can on Android."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS, ekranda olmayan uygulamaları duraklatır. Yakındaki bir cihaz bir şey gönderdiğinde Bluetooth uygulamayı birkaç saniyeliğine uyandırabilir ve sistem uygulamayı kapattıktan sonra yeniden başlatabilir. Uygulama, Android’deki gibi sürekli çalışamaz."
          }
        }
      }
    },
    "onb_bg_forcequit_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you swipe the app away in the app switcher, iOS does not start it again for Bluetooth. Leave it in the background."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı uygulama değiştiricide yukarı kaydırarak kapatırsanız iOS onu Bluetooth için yeniden başlatmaz. Arka planda bırakın."
          }
        }
      }
    },
    "onb_bg_forcequit_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not force-quit the app"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı zorla kapatmayın"
          }
        }
      }
    },
    "onb_bg_lowpower_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low Power Mode reduces background activity. The app then looks for neighbours less often to save battery."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşük Güç Modu arka plan etkinliğini azaltır. Uygulama da pilden tasarruf için komşuları daha seyrek arar."
          }
        }
      }
    },
    "onb_bg_lowpower_off": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low Power Mode is off."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşük Güç Modu kapalı."
          }
        }
      }
    },
    "onb_bg_lowpower_on": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low Power Mode is on."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşük Güç Modu açık."
          }
        }
      }
    },
    "onb_bg_lowpower_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low Power Mode"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşük Güç Modu"
          }
        }
      }
    },
    "onb_bg_mac_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a Mac the app keeps running while it is open. Closing its window does not stop it; quitting the app does."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’te uygulama açık kaldığı sürece çalışmaya devam eder. Penceresini kapatmak onu durdurmaz; uygulamadan çıkmak durdurur."
          }
        }
      }
    },
    "onb_bg_refresh_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When it is off for this app, iOS does not wake the app for Bluetooth. Keep it on in the settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama için kapalıysa iOS uygulamayı Bluetooth için uyandırmaz. Ayarlardan açık tutun."
          }
        }
      }
    },
    "onb_bg_refresh_off": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: the app only works while it is on screen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı: uygulama yalnızca ekrandayken çalışır."
          }
        }
      }
    },
    "onb_bg_refresh_on": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On: Bluetooth can wake the app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık: Bluetooth uygulamayı uyandırabilir."
          }
        }
      }
    },
    "onb_bg_refresh_restricted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restricted by the system or a profile."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem veya bir profil tarafından kısıtlanmış."
          }
        }
      }
    },
    "onb_bg_refresh_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background App Refresh"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka Planda Uygulama Yenileme"
          }
        }
      }
    },
    "onb_done_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can join the mesh now, or later from the home screen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağa şimdi katılabilir ya da daha sonra ana sayfadan katılabilirsiniz."
          }
        }
      }
    },
    "onb_done_identity_missing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No identity yet. Go back and create it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kimlik yok. Geri dönüp oluşturun."
          }
        }
      }
    },
    "onb_done_identity_ok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identity created."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimlik oluşturuldu."
          }
        }
      }
    },
    "onb_done_nearby_missing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth permissions are still missing. You will be asked when you join."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth izinleri hâlâ eksik. Katılırken sorulacak."
          }
        }
      }
    },
    "onb_done_nearby_ok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth permissions granted."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth izinleri verildi."
          }
        }
      }
    },
    "onb_done_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re all set"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazırsınız"
          }
        }
      }
    },
    "onb_failure_database": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved data cannot be read. If you switched between app versions, delete the app and install it again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı veriler okunamıyor. Uygulama sürümleri arasında geçiş yaptıysanız uygulamayı silip yeniden yükleyin."
          }
        }
      }
    },
    "onb_failure_encryption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build of the app cannot encrypt its data, so it does not store anything."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın bu derlemesi verilerini şifreleyemez, bu yüzden hiçbir şey saklamaz."
          }
        }
      }
    },
    "onb_failure_generic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something unexpected went wrong. Try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklenmedik bir sorun oluştu. Yeniden deneyin."
          }
        }
      }
    },
    "onb_failure_newer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved data was written by a newer version of the app. Update the app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı veriler uygulamanın daha yeni bir sürümüyle yazılmış. Uygulamayı güncelleyin."
          }
        }
      }
    },
    "onb_failure_secrets": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device’s secure storage (Keychain) is not available right now. Try again in a moment."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazın güvenli depolaması (Anahtar Zinciri) şu anda kullanılamıyor. Biraz sonra tekrar deneyin."
          }
        }
      }
    },
    "onb_failure_secrets_resettable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device’s secure storage can no longer unlock the saved identity. This happens after some system changes or when the app is restored on another device. The only way forward is to reset the identity."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazın güvenli depolaması artık kayıtlı kimliğin kilidini açamıyor. Bu, bazı sistem değişikliklerinden sonra veya uygulama başka bir cihaza geri yüklendiğinde olur. Tek çıkış yolu kimliği sıfırlamak."
          }
        }
      }
    },
    "onb_get_started": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get started"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başla"
          }
        }
      }
    },
    "onb_identity_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app creates a key pair on this phone. The secret part is kept in the phone’s protected storage and never leaves it. There is nothing to sign up for."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama bu telefonda bir anahtar çifti oluşturur. Gizli kısım telefonun korumalı depolamasında saklanır ve oradan hiç çıkmaz. Kaydolacak bir şey yoktur."
          }
        }
      }
    },
    "onb_identity_create": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create my identity"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimliğimi oluştur"
          }
        }
      }
    },
    "onb_identity_created": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your identity is ready"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimliğiniz hazır"
          }
        }
      }
    },
    "onb_identity_creating": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creating your identity…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimliğiniz oluşturuluyor…"
          }
        }
      }
    },
    "onb_identity_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The identity could not be created"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimlik oluşturulamadı"
          }
        }
      }
    },
    "onb_identity_reset": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset identity…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimliği sıfırla…"
          }
        }
      }
    },
    "onb_identity_safety_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you meet someone, read this number to each other to be sure that you have the right person."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biriyle karşılaştığınızda, doğru kişi olduğundan emin olmak için bu numarayı birbirinize okuyun."
          }
        }
      }
    },
    "onb_identity_safety_label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safety number"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik numarası"
          }
        }
      }
    },
    "onb_identity_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create your identity"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimliğinizi oluşturun"
          }
        }
      }
    },
    "onb_join_now": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join the mesh now"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağa şimdi katıl"
          }
        }
      }
    },
    "onb_nearby_allow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Bluetooth"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth’a izin ver"
          }
        }
      }
    },
    "onb_nearby_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app needs to look for other phones and talk to them over Bluetooth."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın diğer telefonları araması ve onlarla Bluetooth üzerinden konuşması gerekir."
          }
        }
      }
    },
    "onb_nearby_ready": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is in place: Bluetooth is allowed and on."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey hazır: Bluetooth’a izin verildi ve açık."
          }
        }
      }
    },
    "onb_nearby_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find phones around you"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrenizdeki telefonları bulun"
          }
        }
      }
    },
    "onb_nearby_why_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system asks once before an app may use Bluetooth. Crisis Network uses it only to find and talk to nearby devices, never to learn where you are."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem, bir uygulamanın Bluetooth’u kullanmasından önce bir kez sorar. Kriz Ağı onu yalnızca yakındaki cihazları bulmak ve onlarla konuşmak için kullanır, nerede olduğunuzu öğrenmek için asla."
          }
        }
      }
    },
    "onb_nearby_why_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why the system asks"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem neden soruyor"
          }
        }
      }
    },
    "onb_next": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam"
          }
        }
      }
    },
    "onb_open_app": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the app"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı aç"
          }
        }
      }
    },
    "onb_point_offline_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phones talk to each other directly over Bluetooth. Nothing needs a mobile network or Wi-Fi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonlar birbirleriyle doğrudan Bluetooth üzerinden konuşur. Mobil şebekeye ya da Wi-Fi’a gerek yoktur."
          }
        }
      }
    },
    "onb_point_offline_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works without internet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnternetsiz çalışır"
          }
        }
      }
    },
    "onb_point_private_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are identified by a key that is created on this phone. Private messages are encrypted; announcements are public."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimliğiniz bu telefonda oluşturulan bir anahtardır. Özel mesajlar şifrelenir; duyurular herkese açıktır."
          }
        }
      }
    },
    "onb_point_private_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account, no phone number"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap yok, telefon numarası yok"
          }
        }
      }
    },
    "onb_point_relay_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every phone that runs the app passes messages on, so they can travel further than one Bluetooth link reaches."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı çalıştıran her telefon mesajları iletir; böylece mesajlar tek bir Bluetooth bağlantısının ulaştığından daha uzağa gidebilir."
          }
        }
      }
    },
    "onb_point_relay_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages hop from phone to phone"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajlar telefondan telefona atlar"
          }
        }
      }
    },
    "onb_reset_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The old identity and all messages stored on this phone are deleted and cannot be recovered. A new identity is created afterwards."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski kimlik ve bu telefonda saklanan tüm mesajlar silinir, geri alınamaz. Ardından yeni bir kimlik oluşturulur."
          }
        }
      }
    },
